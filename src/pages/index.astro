---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portafolio de José Casillas - Desarrollador Full Stack" />
    <link rel="icon" type="image/svg+xml" href="/portfolio.svg" />
    <title>José Casillas - Desarrollador FrontEnd</title>
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans">
    <!-- Header/Navigation -->
    <header class="fixed w-full bg-white shadow-md z-50">
      <nav class="container mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
          <a href="#" class="text-2xl font-bold text-indigo-600">José Casillas</a>
          
          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center space-x-8">
            <a href="#inicio" class="text-gray-600 hover:text-indigo-600 transition-colors duration-300">Inicio</a>
            <a href="#proyectos" class="text-gray-600 hover:text-indigo-600 transition-colors duration-300">Proyectos</a>
            <a href="#sobre-mi" class="text-gray-600 hover:text-indigo-600 transition-colors duration-300">Sobre Mí</a>
            <a href="#experiencia" class="text-gray-600 hover:text-indigo-600 transition-colors duration-300">Experiencia</a>
            <a href="#habilidades" class="text-gray-600 hover:text-indigo-600 transition-colors duration-300">Habilidades</a>
            <a href="#contacto" class="text-gray-600 hover:text-indigo-600 transition-colors duration-300">Contacto</a>
            
            <div class="flex items-center space-x-4 ml-4">
              <a href="https://wa.me/5215513647398" target="_blank" class="text-gray-600 hover:text-emerald-500 transition-colors duration-300 text-xl" aria-label="WhatsApp">
                <i class="bi bi-whatsapp"></i>
              </a>
              <a href="https://www.instagram.com/jose_casillas02/" target="_blank" class="text-gray-600 hover:text-pink-500 transition-colors duration-300 text-xl" aria-label="Instagram">
                <i class="bi bi-instagram"></i>
              </a>
              <a href="https://www.facebook.com/jose.casillas.696282/?locale=es_LA" target="_blank" class="text-gray-600 hover:text-indigo-600 transition-colors duration-300 text-xl" aria-label="Facebook">
                <i class="bi bi-facebook"></i>
              </a>
            </div>
          </div>
          
          <!-- Mobile menu button -->
          <div class="md:hidden flex items-center space-x-4">
            <div class="flex space-x-2">
              <a href="https://wa.me/5215513647398" target="_blank" class="text-gray-600 hover:text-emerald-500 transition-colors duration-300 text-xl" aria-label="WhatsApp">
                <i class="bi bi-whatsapp"></i>
              </a>
              <a href="https://www.instagram.com/jose_casillas02/" target="_blank" class="text-gray-600 hover:text-pink-500 transition-colors duration-300 text-xl" aria-label="Instagram">
                <i class="bi bi-instagram"></i>
              </a>
              <a href="https://www.facebook.com/jose.casillas.696282/?locale=es_LA" target="_blank" class="text-gray-600 hover:text-indigo-600 transition-colors duration-300 text-xl" aria-label="Facebook">
                <i class="bi bi-facebook"></i>
              </a>
            </div>
            <button 
              id="mobile-menu-button" 
              class="text-gray-600 hover:text-indigo-600 focus:outline-none"
              aria-label="Toggle menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
        
        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-gray-200">
          <div class="flex flex-col space-y-3 mt-4">
            <a href="#inicio" class="block px-3 py-2 rounded-md text-gray-700 hover:bg-gray-100">Inicio</a>
            <a href="#proyectos" class="block px-3 py-2 rounded-md text-gray-700 hover:bg-gray-100">Proyectos</a>
            <a href="#sobre-mi" class="block px-3 py-2 rounded-md text-gray-700 hover:bg-gray-100">Sobre Mí</a>
            <a href="#experiencia" class="block px-3 py-2 rounded-md text-gray-700 hover:bg-gray-100">Experiencia</a>
            <a href="#habilidades" class="block px-3 py-2 rounded-md text-gray-700 hover:bg-gray-100">Habilidades</a>
            <a href="#contacto" class="block px-3 py-2 rounded-md text-gray-700 hover:bg-gray-100">Contacto</a>
          </div>
        </div>
      </nav>
    </header>

    <!-- Hero Section -->
    <section id="inicio" class="pt-32 pb-20 px-6 bg-gradient-to-r from-indigo-50 to-purple-50">
      <div class="container mx-auto flex flex-col md:flex-row items-center">
        <div class="md:w-1/2 mb-10 md:mb-0">
          <h1 class="text-4xl md:text-6xl font-bold mb-6">
            Hola, soy <span class="text-indigo-600">José Casillas</span>
          </h1>
          <h2 class="text-2xl md:text-3xl text-gray-600 mb-8">
            Desarrollador FrontEnd apasionado por crear soluciones digitales
          </h2>
          <p class="text-gray-600 mb-8 text-lg">
            Construyendo experiencias web rápidas, accesibles y memorables con tecnologías modernas.
          </p>
          <div class="flex flex-wrap gap-4">
            <a 
              href="#proyectos" 
              class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors duration-300"
            >
              Ver mis proyectos
            </a>
            <a 
              href="#contacto" 
              class="border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 font-semibold py-3 px-6 rounded-lg transition-colors duration-300"
            >
              Contáctame
            </a>
            <a 
              href="/cv/JoseCV.pdf" 
              download="JoseCasillas_CV.pdf"
              class="bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg transition-colors duration-300 flex items-center gap-2"
            >
              <i class="bi bi-download"></i>
              Descargar CV
            </a>
          </div>
        </div>
        <div class="md:w-1/2 flex justify-center">
          <div class="relative w-64 h-64 md:w-80 md:h-80 rounded-full overflow-hidden border-4 border-indigo-100 shadow-xl">
            <img 
              src="/perfil/Yo.jpg" 
              alt="José Casillas" 
              class="w-full h-full object-cover"
              onerror="this.src='https://via.placeholder.com/400x400?text=José+Casillas'"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Sobre Mí Section -->
    <section id="sobre-mi" class="py-20 px-6 bg-white">
      <div class="container mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">
          Sobre <span class="text-indigo-600">Mí</span>
        </h2>
        
        <div class="flex flex-col md:flex-row items-center">
          <div class="md:w-1/3 mb-10 md:mb-0 flex justify-center">
            <div class="relative w-64 h-64 rounded-2xl overflow-hidden shadow-xl transform rotate-3 hover:rotate-0 transition-transform duration-500">
              <img 
                src="/perfil/Yo.jpg" 
                alt="José Casillas" 
                class="w-full h-full object-cover"
                onerror="this.src='https://via.placeholder.com/400x400?text=José+Casillas'"
              />
            </div>
          </div>
          
          <div class="md:w-2/3 md:pl-12">
            <h3 class="text-2xl font-semibold mb-6">¡Hola! Soy José Casillas</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Ingeniero en Sistemas Computacionales enfocado en el desarrollo FrontEnd. <br>
              Mi trabajo consiste en tender un puente entre la lógica técnica y una interfaz visual impecable. 
              Me especializo en construir aplicaciones web modernas con tecnologías como React, Astro y Tailwind, priorizando siempre la escalabilidad y el rendimiento.
            </p>
            <p class="text-gray-600 mb-8 leading-relaxed">
              No solo escribo código; diseño experiencias digitales eficientes que resuelven problemas reales y aportan valor al usuario final.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="flex items-start">
                <div class="bg-indigo-100 p-3 rounded-full mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M12 18h.01" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-lg mb-1">Experiencia</h4>
                  <p class="text-gray-600">Más de 3 años desarrollando aplicaciones web.</p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="bg-indigo-100 p-3 rounded-full mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-lg mb-1">Habilidades</h4>
                  <p class="text-gray-600">Frontend.</p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="bg-indigo-100 p-3 rounded-full mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-lg mb-1">Educación</h4>
                  <p class="text-gray-600">Universidad Del Desarrollo Empresarial y Pedagógico (UNIVDEP).</p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="bg-indigo-100 p-3 rounded-full mr-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-lg mb-1">Trabajo en Equipo</h4>
                  <p class="text-gray-600">Excelentes habilidades de comunicación y colaboración.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proyectos Section -->
    <section id="proyectos" class="py-20 px-6 bg-white">
      <div class="container mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
          Mis <span class="text-indigo-600">Proyectos</span>
        </h2>
        <p class="text-gray-600 text-center max-w-2xl mx-auto mb-16">
          Algunos de mis trabajos recientes. Cada proyecto es único y resuelve problemas específicos.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
          <!-- Project 1: SysDuo -->
          <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 transform hover:-translate-y-2">
            <div class="h-48 bg-gray-200 overflow-hidden">
              <img 
                src="/jose.png" 
                alt="SysDuo" 
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">SysDuo</h3>
              <p class="text-gray-600 mb-4">
                Proyecto en equipo de soporte técnico de calidad, desarrollo web, mantenimiento preventivo de sistemas y gestión de incidentes. Solución integral para resolver problemas técnicos de manera eficiente y armado de PC's
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">react</span>
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">Node.js</span>
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">MongoDB</span>
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">Tailwind CSS</span>
              </div>
              <div class="flex justify-between items-center">
                <a href="https://sys-duo.netlify.app/" target="_blank" class="text-indigo-600 hover:text-indigo-800 font-medium text-sm flex items-center">
                  Ver más
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <div class="flex space-x-2">
                  <a href="#" class="text-gray-500 hover:text-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                  </a>
                  <a href="#" class="text-gray-500 hover:text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2 16h-2v-6h2v6zm-1-6.891c-.607 0-1.1-.496-1.1-1.108 0-.612.492-1.108 1.1-1.108s1.1.496 1.1 1.108c0 .612-.494 1.108-1.1 1.108zm8 6.891h-1.706v-3.556c0-.976-.5-1.444-1.5-1.444-1.2 0-1.794.8-1.794 1.8v3.2h-1.7v-6h1.7v.9c.4-.6 1.2-1 2.1-1 1.6 0 2.9 1 2.9 3.1v3z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Project 2: Ecommerce Marina -->
          <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 transform hover:-translate-y-2">
            <div class="h-48 bg-gray-200 overflow-hidden">
              <img 
                src="/marina.png" 
                alt="Ecommerce Marina" 
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Ecommerce de Marina "Un Suspiro Navideño"</h3> 
              <p class="text-gray-600 mb-4">
                Plataforma de comercio electrónico profesional desarrollada para cliente. Solución integral con carrito de compras, gestión de inventario y pasarela de pago.
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">React</span>
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">MongoDB</span>
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">Node.js</span>
                <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded">Tailwind CSS</span>
              </div>
              <div class="flex justify-between items-center">
                <a href="https://tienda-marina.vercel.app/" target="_blank" class="text-indigo-600 hover:text-indigo-800 font-medium text-sm flex items-center">
                  Ver más
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <div class="flex space-x-2">
                  <a href="#" class="text-gray-500 hover:text-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                  </a>
                  <a href="#" class="text-gray-500 hover:text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2 16h-2v-6h2v6zm-1-6.891c-.607 0-1.1-.496-1.1-1.108 0-.612.492-1.108 1.1-1.108s1.1.496 1.1 1.108c0 .612-.494 1.108-1.1 1.108zm8 6.891h-1.706v-3.556c0-.976-.5-1.444-1.5-1.444-1.2 0-1.794.8-1.794 1.8v3.2h-1.7v-6h1.7v.9c.4-.6 1.2-1 2.1-1 1.6 0 2.9 1 2.9 3.1v3z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Experiencia Section -->
    <section id="experiencia" class="py-20 px-6 bg-gray-50">
      <div class="container mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">
          Mi <span class="text-indigo-600">Experiencia</span>
        </h2>
        
        <div class="max-w-4xl mx-auto">
          <!-- Experiencia 1 -->
          <div class="mb-12">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4">
              <h3 class="text-2xl font-bold text-gray-800">Soporte Técnico</h3>
              <span class="text-indigo-600 font-medium">2017 - 2020</span>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-md">
              <p class="text-gray-700 mb-4">
                Proporcione asistencia técnica a usuarios finales, resolviendo problemas de software y hardware, gestión de incidentes y mantenimiento de sistemas informáticos.
              </p>
              <div class="mt-4">
                <h4 class="font-semibold text-gray-800 mb-2">Habilidades principales:</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm">Diagnóstico de problemas</span>
                  <span class="px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm">Soporte al usuario</span>
                  <span class="px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm">Mantenimiento de sistemas</span>
                  <span class="px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm">Gestión de incidentes</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Experiencia 2 -->
          <div class="mb-12">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4">
              <h3 class="text-2xl font-bold text-gray-800">Desarrollo de Aplicaciones</h3>
              <span class="text-indigo-600 font-medium">2022 - 2023</span>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-md">
              <p class="text-gray-700 mb-4">
                Desarrollo de aplicaciones multiplataforma, trabajando en el ciclo completo de desarrollo desde el análisis de requisitos hasta la implementación y pruebas.
              </p>
              <div class="mt-4">
                <h4 class="font-semibold text-gray-800 mb-2">Tecnologías principales:</h4>
